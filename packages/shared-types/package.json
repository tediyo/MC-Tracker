{
  "name": "@mc-tracker/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared enums, DB row types, Zod schemas, and pure calculation functions used by apps/web and apps/api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "gen:types": "supabase gen types typescript --linked > src/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local > src/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
