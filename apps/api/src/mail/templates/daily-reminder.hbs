<!doctype html>
<html>
  <body style="font-family: -apple-system, 'Segoe UI', sans-serif; background: #f9f9f7; padding: 24px; color: #0b0b0b;">
    <div style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 24px; border: 1px solid #e1e0d9;">
      <h1 style="font-size: 18px; margin-top: 0;">MC Tracker</h1>
      <p>You haven&rsquo;t logged any costs for <strong>{{dateLabel}}</strong> yet.</p>
      <p>
        <a href="{{costsUrl}}" style="display: inline-block; background: #2a78d6; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;">
          Log today's costs
        </a>
      </p>
      <p style="color: #898781; font-size: 12px;">You'll keep getting this reminder every hour until an entry is logged for today.</p>
    </div>
  </body>
</html>
