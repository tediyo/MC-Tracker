<!doctype html>
<html>
  <body style="font-family: -apple-system, 'Segoe UI', sans-serif; background: #f9f9f7; padding: 24px; color: #0b0b0b;">
    <div style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 24px; border: 1px solid #d03b3b;">
      <h1 style="font-size: 18px; margin-top: 0; color: #d03b3b;">You're over budget for {{monthLabel}}</h1>
      <p>Your total costs have gone over your target for this month:</p>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
        <tr>
          <td style="padding: 6px 0; color: #52514e;">Target cost limit</td>
          <td style="padding: 6px 0; text-align: right;">{{targetCostLimit}}</td>
        </tr>
        <tr>
          <td style="padding: 6px 0; color: #52514e;">Total costs so far</td>
          <td style="padding: 6px 0; text-align: right; font-weight: 600;">{{totalCost}}</td>
        </tr>
        <tr>
          <td style="padding: 6px 0; color: #d03b3b; border-top: 1px solid #e1e0d9;">Over by</td>
          <td style="padding: 6px 0; text-align: right; font-weight: 700; color: #d03b3b; border-top: 1px solid #e1e0d9;">{{overBy}}</td>
        </tr>
      </table>
      <p>
        <a href="{{plansUrl}}" style="display: inline-block; background: #2a78d6; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;">
          Review your plan
        </a>
      </p>
      <p style="color: #898781; font-size: 12px;">You won't get another alert like this until next month, even if you log more costs now.</p>
    </div>
  </body>
</html>
