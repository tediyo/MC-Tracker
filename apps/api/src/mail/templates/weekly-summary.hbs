<!doctype html>
<html>
  <body style="font-family: -apple-system, 'Segoe UI', sans-serif; background: #f9f9f7; padding: 24px; color: #0b0b0b;">
    <div style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 24px; border: 1px solid #e1e0d9;">
      <h1 style="font-size: 18px; margin-top: 0;">Weekly summary - {{weekLabel}}</h1>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
        <tr>
          <td style="padding: 6px 0; color: #52514e;">Total income</td>
          <td style="padding: 6px 0; text-align: right; font-weight: 600;">{{totalIncome}}</td>
        </tr>
        <tr>
          <td style="padding: 6px 0; color: #52514e;">Total costs</td>
          <td style="padding: 6px 0; text-align: right; font-weight: 600;">{{totalCost}}</td>
        </tr>
        <tr>
          <td style="padding: 6px 0; color: #52514e; border-top: 1px solid #e1e0d9;">Net profit / loss</td>
          <td style="padding: 6px 0; text-align: right; font-weight: 700; border-top: 1px solid #e1e0d9;">{{netProfitLoss}}</td>
        </tr>
      </table>
      {{#if costByCategory.length}}
        <h2 style="font-size: 14px; color: #52514e;">Cost breakdown</h2>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
          {{#each costByCategory}}
            <tr>
              <td style="padding: 4px 0; text-transform: capitalize;">{{category}}</td>
              <td style="padding: 4px 0; text-align: right;">{{amount}}</td>
            </tr>
          {{/each}}
        </table>
      {{/if}}
      <p>
        <a href="{{dashboardUrl}}" style="display: inline-block; background: #2a78d6; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;">
          View full dashboard
        </a>
      </p>
    </div>
  </body>
</html>
