# --- Server ---
PORT=3001
# IANA timezone used for every cron boundary ("today", "this week", "this
# month") and for the daily/weekly/monthly job schedules below. Defaulted to
# Africa/Addis_Ababa per the plan's assumption (inferred from the Amharic-
# origin subcategory names) - change if that's wrong for your users.
APP_TIMEZONE=Africa/Addis_Ababa

# --- Supabase ---
# Project Settings -> API. The SERVICE ROLE key bypasses RLS - it is what
# lets the cron jobs scan across every user's data, and it must NEVER be
# exposed to a browser or committed anywhere. It belongs only here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret. Used to verify the
# Supabase session JWT locally (HS256) on the few endpoints that need auth
# (currently just DELETE /account), without a network round-trip per request.
SUPABASE_JWT_SECRET=

# --- Supabase Database Webhook (instant over-budget alert) ---
# Set this to a long random string, then configure a Supabase Database
# Webhook (Dashboard -> Database -> Webhooks) on `costs` INSERT that POSTs
# to this API's /webhooks/costs-insert with header
# `X-Webhook-Secret: <this value>`. See docs/SETUP.md.
SUPABASE_WEBHOOK_SECRET=

# --- Email (Google SMTP/OAuth2 - documented default) ---
GMAIL_USER=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM="MC Tracker <no-reply@example.com>"

# --- Simpler fallback: Gmail App Password instead of OAuth2 ---
# Only use this if you want to skip the Google Cloud OAuth2 consent-screen
# setup for now. Requires a Google account with 2FA enabled and an App
# Password generated under Google Account -> Security -> App passwords.
# If you use this, swap MailModule's transport `auth` block to
# `{ user: GMAIL_USER, pass: GMAIL_APP_PASSWORD }` and delete the OAuth2 vars.
# GMAIL_APP_PASSWORD=

# Base URL of the deployed web app, used in email templates for links back
# into the app (e.g. "Log today's costs" -> ${WEB_APP_URL}/costs).
WEB_APP_URL=http://localhost:3000
