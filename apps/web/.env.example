# Supabase project settings -> API. The anon key is safe to expose to the
# browser (RLS is what actually protects data, not secrecy of this key).
# NEVER put the service-role key in this app - that belongs only in
# apps/api/.env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL this app is served from (used to build auth email redirect links).
# http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
